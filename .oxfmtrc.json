{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortPackageJson": true,

  "ignorePatterns": ["test/fixtures", "**/node_modules", "**/dist", "bun.lock", "tmp"]
}
