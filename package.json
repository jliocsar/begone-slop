{
  "$schema": "http://json.schemastore.org/package",
  "name": "@jliocsar/begone-slop",
  "version": "0.1.1",
  "description": "Oxlint rules that reject low-evidence TypeScript and non-idiomatic Effect",
  "keywords": [
    "effect",
    "lint",
    "oxc",
    "oxlint",
    "plugin",
    "rules",
    "typescript"
  ],
  "homepage": "https://github.com/jliocsar/begone-slop#readme",
  "bugs": {
    "url": "https://github.com/jliocsar/begone-slop/issues"
  },
  "license": "MIT",
  "author": "jliocsar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jliocsar/begone-slop.git"
  },
  "files": [
    "dist",
    "preset.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./preset.json": "./preset.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun tsdown src/index.ts --format esm --dts --clean",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bunx --bun oxlint --deny-warnings",
    "lint:fix": "bunx --bun oxlint --fix --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepack": "bun run build",
    "prepare": "effect-tsgo patch --oxlint"
  },
  "dependencies": {
    "effect": "4.0.0-beta.100",
    "effect-oxlint": "^0.3.3"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.36.1",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "oxlint": ">=1.77.0"
  }
}
